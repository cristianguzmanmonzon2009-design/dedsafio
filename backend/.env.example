# ---------------------------------------------------------------------------
# Entorno del backend Dedsafio
# Copia a `.env` y rellena los valores reales. NUNCA subas `.env` al repo.
# ---------------------------------------------------------------------------

NODE_ENV=development
HOST=0.0.0.0
PORT=8080
# Orígenes CORS separados por coma (vacío = deshabilitado en producción).
CORS_ORIGINS=http://localhost:1420,tauri://localhost

# --- Base de datos -----------------------------------------------------------
# Con docker-compose el host interno es `db`.
DATABASE_URL=postgresql://dedsafio:dedsafio@localhost:5432/dedsafio?schema=public

# --- Secretos (mínimo 32 caracteres aleatorios cada uno) ---------------------
# Genera con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_TOKEN_SECRET=REEMPLAZA_ESTO_por_un_secreto_largo_aleatorio_A
LICENSE_TOKEN_SECRET=REEMPLAZA_ESTO_por_un_secreto_largo_aleatorio_B
DOWNLOAD_URL_SECRET=REEMPLAZA_ESTO_por_un_secreto_largo_aleatorio_C

# --- Claves criptográficas ---------------------------------------------------
# Genera todas con: npm run keys:generate
# Ed25519 (firma de manifiestos/artefactos). PEM codificado en base64.
SIGNING_PRIVATE_KEY_PEM_B64=
SIGNING_PUBLIC_KEY_PEM_B64=
# Clave maestra AES-256 (32 bytes en base64) para cifrar mods en reposo.
# Vive SOLO en el backend. Si se filtra, hay que re-cifrar los artefactos.
MOD_MASTER_KEY_B64=

# --- Identidad del servidor --------------------------------------------------
SERVER_ID=endersafio
SERVER_NAME=EnderSAFIO
SERVER_HOST=127.0.0.1
SERVER_PORT=25565
MINECRAFT_VERSION=1.21.1
FABRIC_LOADER_VERSION=0.16.5
REQUIRED_JAVA_MAJOR=21

# --- Almacenamiento ----------------------------------------------------------
MOD_STORAGE_DIR=./storage
MODS_SOURCE_DIR=../mods-source

# Driver de artefactos cifrados: "local" (disco), "s3" (R2/S3) o "http"
# (host estático; p. ej. assets de un GitHub Release).
STORAGE_DRIVER=local
# Solo para driver "http": base donde viven los .enc (se pide <base>/<archivo>).
MODS_BASE_URL=
# Si STORAGE_DRIVER=s3 (ej. Cloudflare R2):
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=mods
S3_FORCE_PATH_STYLE=false

# --- Versiones del launcher --------------------------------------------------
LAUNCHER_LATEST_VERSION=1.0.0
LAUNCHER_MINIMUM_VERSION=1.0.0
LAUNCHER_MANDATORY=false
LAUNCHER_DOWNLOAD_URL=
LAUNCHER_DOWNLOAD_SHA256=

# --- Branding (opcional, se sirve al launcher) ------------------------------
BRANDING_BACKGROUND_URL=
BRANDING_LOGO_URL=
BRANDING_DISCORD_URL=

# --- Seed de administrador inicial (usado por `npm run db:seed`) -------------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=cambia_esta_clave_ahora
