{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dedsafio Launcher",
  "version": "0.1.0",
  "identifier": "com.dedsafio.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dedsafio Launcher",
        "width": 1100,
        "height": 690,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' https: http://localhost:* http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["Spanish"]
      }
    },
    "publisher": "Dedsafio",
    "category": "Game",
    "shortDescription": "Launcher de Dedsafio",
    "longDescription": "Launcher privado para jugar Dedsafio (Minecraft 1.21.1 + Fabric)."
  }
}
